# Training is a separate concern from serving — notebooks, datasets and
# PyTorch checkpoints must never enter the runtime image.
training/
datasets/
*.pt
*.ipynb

# Local smoke-test weights exported from stock COCO. They know nothing about
# rhinos and are never what the server should load, so keep them out of the
# image rather than shipping ~10MB of dead weight beside the real model.
models/baseline-*.onnx

# Sample media is for local testing only — it must not bloat the runtime image.
samples/
